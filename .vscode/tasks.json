{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "cmake -S . -B build && cmake --build build -j",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc"
        },
        {
            "label": "test",
            "type": "shell",
            "command": "ctest --test-dir build --output-on-failure",
            "dependsOn": "build",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        }
    ]
}
